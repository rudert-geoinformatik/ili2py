{%- from "elements/groups.jinja2" import group with context -%}
@startuml
skinparam linetype {{ linetype }}
{{ direction }} direction
{%- for model_group in diagram.model_groups if model_group.oid in model_names %}
{{ group(
    model_group,
    model_group.name,
    model_group.classes or model_group.topic_groups | selectattr("classes") | list,
) }}
{%- for topic_group in model_group.topic_groups %}
{{ group(
    topic_group,
    model_group.name ~ "." ~ topic_group.name,
    topic_group.classes,
    filter_associations=true,
) }}
{%- endfor %}
{%- endfor %}
@enduml
