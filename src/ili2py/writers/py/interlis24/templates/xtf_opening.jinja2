{%- from "macros/fields.jinja2" import choice, element_field, elements_field %}
{%- from "macros/imports.jinja2" import related_class_imports %}
{%- from "macros/metadata.jinja2" import metadata_property %}

{%- macro transfer_metadata_property(oid) -%}
{{ metadata_property(oid=oid, kind=none, meta_attributes=[], translations={}) }}
{%- endmacro %}

{%- set namespace = render_config['namespace_map']['ili'] %}
{%- set choices -%}
{%- for item in library.topic_choices %}
{{ choice(item.name, item.type_reference, render_config['base_url'] ~ "/" ~ item.model_name) }},
{%- endfor %}
{%- endset -%}

{{ related_class_imports(library.name, library.related_class_imports) }}
from dataclasses import dataclass, field


@dataclass
class DataSection:
    class Meta:
        namespace = "{{ namespace }}"

    {{ elements_field(
        "baskets",
        "list[" ~ library.topic_choices | map(attribute='type_reference') | join(" | ") ~ "]",
        choices,
    ) | indent(4) }}

    {{ transfer_metadata_property("datasection") | indent(4) }}


@dataclass
class Model:
    class Meta:
        namespace = "{{ namespace }}"

    name: str | None = field(default=None, metadata={"type": "Text"})

    {{ transfer_metadata_property("model") | indent(4) }}


@dataclass
class ModelsType:
    {{ elements_field("choice", "list[Model]", choice("model", "Model", namespace) ~ ",") | indent(4) }}


@dataclass
class HeaderSection:
    class Meta:
        namespace = "{{ namespace }}"

    models: ModelsType = field(
        metadata={
            "name": "models",
            "type": "Element",
            "namespace": "{{ namespace }}",
        }
    )
    {%- for name in ["sender", "version", "comment"] %}
    {{ element_field(name, none, "str | None", namespace) | indent(4) }}
    {%- endfor %}

    {{ transfer_metadata_property("headersection") | indent(4) }}


@dataclass
class Transfer:
    class Meta:
        namespace = "{{ namespace }}"
        name = "transfer"

    headersection: HeaderSection = field(metadata={"type": "Element", "namespace": "{{ namespace }}"})
    datasection: DataSection = field(metadata={"type": "Element", "namespace": "{{ namespace }}"})

    {{ transfer_metadata_property("transfer") | indent(4) }}
