{%- from "macros/metadata.jinja2" import metadata_property %}
{%- from "definitions/line_types/polyline.jinja2" import polyline, multi_polyline %}
{%- from "definitions/line_types/surface.jinja2" import surface, multi_surface %}

{%- macro line_types(definitions) -%}
{%- set namespace = render_config['namespace_map']['geom'] %}
{%- for line_type in definitions %}
{%- set line_form = line_type.attribute.name.lower() %}
{%- set line_type_macro = none %}
{%- if line_form in ["polyline", "directedpolyline"] %}
{%- set line_type_macro = multi_polyline if line_type.multi else polyline %}
{%- elif line_form in ["surface", "area"] %}
{%- set line_type_macro = multi_surface if line_type.multi else surface %}
{%- endif %}
{%- if line_type_macro %}

{% call line_type_macro(
    line_type.name,
    line_type.attribute.types[0],
    namespace,
    meta_attributes=line_type.attribute.meta_attributes,
    doc=line_type.doc,
) -%}
{{ metadata_property(
    oid=line_type.identifier,
    kind="LineType",
    meta_attributes=line_type.meta_attributes,
    max_overlap=line_type.max_overlap,
    straights=line_type.straights,
    arcs=line_type.arcs,
    translations=line_type.translations,
) }}
{%- endcall %}
{%- endif %}
{%- endfor %}
{%- endmacro %}
