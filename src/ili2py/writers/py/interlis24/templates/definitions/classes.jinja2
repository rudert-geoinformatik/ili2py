{%- from "macros/docs.jinja2" import member_docstring %}
{%- from "macros/fields.jinja2" import attribute_field %}
{%- from "macros/metadata.jinja2" import interlis, metadata_property %}
{%- from "macros/properties.jinja2" import constraints_properties, geom_properties %}
{%- from "definitions/enumerations.jinja2" import enumerations with context %}
{%- from "definitions/line_types.jinja2" import line_types with context %}

{%- macro classes(definitions) -%}
{%- set ili_namespace = render_config['namespace_map']['ili'] %}
{%- for class_definition in definitions %}

@dataclass
{%- if class_definition.super_class %}
class {{ class_definition.name }}({{ class_definition.super_class }}):
{%- elif class_definition.abstract %}
class {{ class_definition.name }}(ABC):
{%- else %}
class {{ class_definition.name }}:
{%- endif %}
{%- set members -%}
{%- for attribute in class_definition.attributes | selectattr("doc") %}
{{ attribute.name }}: {{ " ".join(attribute.doc) }}
{%- endfor %}
{%- endset %}
    {{ member_docstring(" ".join(class_definition.doc), "Attributes", members | trim) | indent(4) }}

    class Meta:
        namespace = "{{ render_config['base_url'] }}/{{ package.name }}"

    {%- for attribute in class_definition.attributes %}
    {%- if attribute.enumeration %}
    {{ enumerations([attribute.enumeration]) | indent(4) }}
    {%- endif %}
    {%- if attribute.line_type %}
    {{ line_types([attribute.line_type]) | indent(4) }}
    {%- endif %}
    {%- if attribute.type_related_type_class %}
    {{ classes([attribute.type_related_type_class]) | indent(4) }}
    {%- endif %}
    {%- endfor %}

    {%- if class_definition.oid %}

    {{ attribute_field(
        class_definition.oid.name,
        "tid",
        '"' ~ class_definition.oid.types | join(' | ') ~ ' | None"',
        ili_namespace,
        meta_attributes=[],
        type_restrictions=class_definition.oid.type_restrictions,
        translations=class_definition.oid.translations,
    ) | indent(4) }}
    {%- elif class_definition.kind == 'Class' %}

    {{ attribute_field(
        "tid",
        "tid",
        namespace=ili_namespace,
        meta_attributes=[],
        type_restrictions=none,
        translations={},
    ) | indent(4) }}
    {%- endif %}

    {%- for attribute in class_definition.attributes %}
    {%- set attribute_types = attribute.types | join(" | ") %}
    {%- set reference_targets = {"reference_targets": attribute.reference_targets} if attribute.reference_targets else {} %}

    {{ attribute.name }}{% if attribute.name in reserved_python_key_words %}_{% endif %}: "{% if attribute.is_list_type %}list[{{ attribute_types }}]{% else %}{{ attribute_types }} | None{% endif %}" = field(
        {%- if attribute.is_list_type %}
        default_factory=list,
        {%- else %}
        default=None,
        {%- endif %}
        metadata={
            "type": "{{ 'Text' if attribute.kind == 'MVT' else 'Element' }}",
            "namespace": "{{ render_config['base_url'] }}/{{ attribute.namespace_package }}",
            {%- if attribute.type_restrictions['type_related_type'] %}
            "name": "{{ attribute.identifier.split('.')[-1] }}",
            {%- else %}
            "name": "{{ attribute.name }}",
            {%- endif %}
            {{ interlis(
                oid=attribute.identifier,
                meta_attributes=attribute.meta_attributes,
                type_restrictions=attribute.type_restrictions,
                translations=attribute.translations,
                **reference_targets
            ) | indent(12) }},
            "geometric": {
                "is_geometric": {{ attribute.geometric }},
                "multi": {{ attribute.geometric_multi }},
                "point_like": {{ attribute.geometric_is_point_like }},
                "line_like": {{ attribute.geometric_is_line_like }},
                "polygon_like": {{ attribute.geometric_is_polygon_like }},
            },
        },
    )
    {%- endfor %}

    {{ metadata_property(
        oid=class_definition.identifier,
        kind=class_definition.kind | string,
        meta_attributes=class_definition.meta_attributes,
        translations=class_definition.translations,
    ) | indent(4) }}
    {{ constraints_properties(class_definition) | indent(4) }}
    {{ geom_properties(class_definition) | indent(4) }}
{%- endfor %}
{%- endmacro %}
