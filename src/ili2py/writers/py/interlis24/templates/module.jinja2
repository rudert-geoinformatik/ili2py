{%- from "macros/docs.jinja2" import docstring %}
{%- from "macros/fields.jinja2" import attribute_field, choice, elements_field %}
{%- from "macros/imports.jinja2" import definition_imports, imported_packages, related_class_imports %}
{%- from "macros/metadata.jinja2" import module_metadata %}
{%- from "definitions/all.jinja2" import all_definitions with context -%}
{{ docstring(module.doc) }}
{{ definition_imports(module.library) }}
from {{ module.library }} import INTERLIS
{{ imported_packages(module.library, module.imported_packages) }}
{{ related_class_imports(module.library, module.related_class_imports) }}

{{ module_metadata(module) }}
{{ all_definitions(module) }}
{%- if module.basket.choices %}
{%- set choices -%}
{%- for item in module.basket.choices %}
{{ choice(item.name, item.type_reference, render_config['base_url'] ~ "/" ~ item.model_name) }},
{%- endfor %}
{%- endset %}


@dataclass
class {{ module.name }}TOPIC:
    class Meta:
        name = "{{ module.name }}"

    {{ elements_field(
        "elements",
        "list[Union[" ~ module.basket.choices | map(attribute='type_reference') | join(", ") ~ "]]",
        choices,
    ) | indent(4) }}
    {%- for name in ["bid", "kind"] %}
    {{ attribute_field(name, none, namespace=render_config['namespace_map']['ili']) | indent(4) }}
    {%- endfor %}
{%- endif %}
