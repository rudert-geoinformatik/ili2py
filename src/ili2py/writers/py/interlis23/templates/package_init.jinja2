{%- from "macros/docs.jinja2" import docstring %}
{%- from "macros/imports.jinja2" import definition_imports, imported_packages, related_class_imports %}
{%- from "macros/metadata.jinja2" import module_metadata %}
{%- from "definitions/all.jinja2" import all_definitions with context -%}

{{ definition_imports(package.library) }}
{%- if package.name != 'INTERLIS' %}
from {{ package.library }} import INTERLIS
{%- endif %}
{{ imported_packages(package.library, package.imported_packages) }}
{{ related_class_imports(package.library, package.related_class_imports) }}
{{ docstring(package.doc) }}


VERSION = {% if package.version %}"{{ package.version }}"{% else %}{{ package.version }}{% endif %}
ILI_VERSION = "{{ package.ili_version }}"

{{ module_metadata(package) }}
{{ all_definitions(package) }}
