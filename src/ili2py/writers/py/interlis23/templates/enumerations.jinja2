{%- for enumeration in enumerations %}
class {{ enumeration.name }}(str, Enum):
    {%- if enumeration.doc or enumeration.value_docs %}
    """
    {%- if enumeration.doc %}
    {{ "\n".join(enumeration.doc) }}
    {%- endif %}
    {%- if enumeration.value_docs %}
    {% if enumeration.doc %}
    {% endif -%}
    Attributes:
    {%- for value, doc in enumeration.value_docs.items() %}
        {{ value.upper().replace('.', '_') }}: {{ " ".join(doc) }}
    {%- endfor %}
    {%- endif %}
    """
    {%- endif -%}
{% for value in enumeration.values %}
    {{ value.upper().replace('.', '_') }} = "{{ enumeration.value_tags.get(value, value) }}", {{ enumeration.value_translations.get(value, {}) }}
    {%- if value in enumeration.value_docs %}
    """{{ " ".join(enumeration.value_docs[value]) }}"""
    {%- endif %}
{%- endfor %}

    def __new__(cls, value: str, translations: dict[str, str]):
        # the value stays the plain XTF value, translations are attached to each member
        member = str.__new__(cls, value)
        member._value_ = value
        member.translations = translations
        return member

    @property
    def metadata(self) -> dict:
        return {
            "ili2py": {

            },
            "interlis": {
                "oid": "{{ enumeration.identifier }}",
                "kind": "Enumeration",
                "meta_attributes": {
                    {%- for item in enumeration.meta_attributes %}
                        "{{ item.name }}": "{{ item.value }}",
                    {%- endfor %}
                },
                "translations": {{ enumeration.translations }},
            }
        }
{% endfor -%}
