{%- from "macros/fields.jinja2" import choice, element_field, elements_field %}
{%- from "macros/imports.jinja2" import related_class_imports %}
{%- from "macros/metadata.jinja2" import metadata_property %}

{%- macro transfer_metadata_property(oid) -%}
{{ metadata_property(oid=oid, kind=none, meta_attributes=[], translations={}) }}
{%- endmacro %}

{%- set namespace = render_config['namespace_map']['ili'] %}
{%- set choices -%}
{%- for item in library.topic_choices %}
{{ choice(item.tag, item.type_reference, namespace) }},
{%- endfor %}
{%- endset -%}

{{ related_class_imports(library.name, library.related_class_imports) }}
from dataclasses import dataclass, field


@dataclass
class DataSection:
    class Meta:
        namespace = "{{ namespace }}"

    {{ elements_field(
        "baskets",
        "list[" ~ library.topic_choices | map(attribute='type_reference') | join(" | ") ~ "]",
        choices,
    ) | indent(4) }}

    {{ transfer_metadata_property("DATASECTION") | indent(4) }}


@dataclass
class Model:
    class Meta:
        namespace = "{{ namespace }}"

    name: str | None = field(default=None, metadata={"name": "NAME", "type": "Attribute"})
    version: str | None = field(default=None, metadata={"name": "VERSION", "type": "Attribute"})
    uri: str | None = field(default=None, metadata={"name": "URI", "type": "Attribute"})

    {{ transfer_metadata_property("MODEL") | indent(4) }}


@dataclass
class ModelsType:
    {{ elements_field("choice", "list[Model]", choice("MODEL", "Model", namespace) ~ ",") | indent(4) }}


@dataclass
class TagEntry:
    from_value: str | None = field(default=None, metadata={"name": "FROM", "type": "Attribute"})
    to_value: str | None = field(default=None, metadata={"name": "TO", "type": "Attribute"})


@dataclass
class ValEntry:
    tag: str | None = field(default=None, metadata={"name": "TAG", "type": "Attribute"})
    attr: str | None = field(default=None, metadata={"name": "ATTR", "type": "Attribute"})
    from_value: str | None = field(default=None, metadata={"name": "FROM", "type": "Attribute"})
    to_value: str | None = field(default=None, metadata={"name": "TO", "type": "Attribute"})


@dataclass
class DelEntry:
    tag: str | None = field(default=None, metadata={"name": "TAG", "type": "Attribute"})
    attr: str | None = field(default=None, metadata={"name": "ATTR", "type": "Attribute"})


@dataclass
class EntriesType:
    {%- set entry_choices -%}
    {{ choice("TAGENTRY", "TagEntry", namespace) }},
    {{ choice("VALENTRY", "ValEntry", namespace) }},
    {{ choice("DELENTRY", "DelEntry", namespace) }},
    {%- endset %}
    {{ elements_field("choice", "list[TagEntry | ValEntry | DelEntry]", entry_choices) | indent(4) }}
    for_value: str | None = field(default=None, metadata={"name": "FOR", "type": "Attribute"})


@dataclass
class AliasType:
    entries: list[EntriesType] = field(
        default_factory=list,
        metadata={
            "name": "ENTRIES",
            "type": "Element",
            "namespace": "{{ namespace }}",
        },
    )


@dataclass
class OidSpace:
    name: str | None = field(default=None, metadata={"name": "NAME", "type": "Attribute"})
    oid_domain: str | None = field(default=None, metadata={"name": "OIDDOMAIN", "type": "Attribute"})


@dataclass
class OidSpacesType:
    oid_spaces: list[OidSpace] = field(
        default_factory=list,
        metadata={
            "name": "OIDSPACE",
            "type": "Element",
            "namespace": "{{ namespace }}",
        },
    )


@dataclass
class HeaderSection:
    """The HEADERSECTION of INTERLIS 2.3, structure as in ili2c (XSDGenerator)."""

    class Meta:
        namespace = "{{ namespace }}"

    models: ModelsType = field(
        metadata={
            "name": "MODELS",
            "type": "Element",
            "namespace": "{{ namespace }}",
        }
    )
    {%- for name, annotation, tag in [
        ("alias", "AliasType", "ALIAS"),
        ("oid_spaces", "OidSpacesType", "OIDSPACES"),
        ("comment", "str", "COMMENT"),
    ] %}
    {{ element_field(name, tag, annotation ~ " | None", namespace) | indent(4) }}
    {%- endfor %}
    sender: str | None = field(default=None, metadata={"name": "SENDER", "type": "Attribute"})
    version: str | None = field(default=None, metadata={"name": "VERSION", "type": "Attribute"})

    {{ transfer_metadata_property("HEADERSECTION") | indent(4) }}


@dataclass
class Transfer:
    class Meta:
        namespace = "{{ namespace }}"
        name = "TRANSFER"

    headersection: HeaderSection = field(
        metadata={"name": "HEADERSECTION", "type": "Element", "namespace": "{{ namespace }}"}
    )
    datasection: DataSection = field(
        metadata={"name": "DATASECTION", "type": "Element", "namespace": "{{ namespace }}"}
    )

    {{ transfer_metadata_property("TRANSFER") | indent(4) }}
