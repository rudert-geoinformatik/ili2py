{%- set namespace = render_config['namespace_map']['ili'] -%}
from dataclasses import dataclass, field


@dataclass
class Ref:
    class Meta:
        namespace = "{{ namespace }}"
        name = "REF"

    ref: str | None = field(default=None, metadata={"type": "Attribute", "name": "REF"})


@dataclass
class Oid:
    """Value of an attribute of an OID type, INTERLIS 2.3 encodes it as <attr OID="..."/>"""

    class Meta:
        namespace = "{{ namespace }}"

    oid: str | None = field(default=None, metadata={"type": "Attribute", "name": "OID"})


class BinBlBox(bytes):
    pass


@dataclass
class BinBlBoxType:
    class Meta:
        namespace = "{{ namespace }}"

    BINBLBOX: BinBlBox = field(
        metadata={
            "type": "Element",
            "namespace": "{{ namespace }}",
        }
    )


class XmlBlBoxType(str):
    pass
